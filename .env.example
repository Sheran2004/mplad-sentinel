# Server-side AI keys. Never prefix these with VITE_.
GROQ_API_KEY=

# Optional PostgreSQL connection. Without it, the existing app uses its configured local development fallback.
DATABASE_URL=
GROQ_MODEL=llama-3.3-70b-versatile

# Local persistence for the embedded database (reviews survive restarts)
PGLITE_DIR=.pglite-data

# Accounts (recommended for any shared or public deployment)
# SESSION_SECRET: 32+ random characters (required in production), e.g. `openssl rand -hex 32`
SESSION_SECRET=
# First admin, created on startup if the email does not exist yet. Remove ADMIN_PASSWORD afterwards if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login is required to view data automatically once an admin account exists. Leave these empty for the defaults.
# REQUIRE_LOGIN: "false" turns the login wall off (public read-only dashboard), "true" forces it.
REQUIRE_LOGIN=
# ALLOW_REGISTRATION: "false" closes self-service sign-up (admins then create users). New sign-ups are read-only viewers.
ALLOW_REGISTRATION=
# REGISTRATION_CODE: if set, sign-up also needs this invite code
REGISTRATION_CODE=
